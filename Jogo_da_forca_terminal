void Preencher(char letras[]) {
    for(int i = 0; i < 7; i++) {
        letras[i] = '0';
    }
}

void ImprimirLetras(char letras[]) {
    printf("Letras erradas: %s\n", letras);
}

void Escolher_palavra(int *tamanho, char *escolhida) {
    FILE *arquivo = fopen("palavras.txt", "r");
    
    if (arquivo == NULL) {
        strcpy(escolhida, "PROGRAMACAO");
        *tamanho = strlen(escolhida);
        return;
    }

    int total = 0;
    char a[50];
    while (fgets(a, sizeof(a), arquivo) != NULL) {
        // ignora linhas vazias
        if (strlen(a) > 1) {
            total++;
        }
    }

    if (total == 0) {
        strcpy(escolhida, "PROGRAMACAO");
        *tamanho = strlen(escolhida);
        fclose(arquivo);
        return;
    }

    int sorteio = rand() % total;

    rewind(arquivo);
    int atual = 0;
    while (fgets(a, sizeof(a), arquivo) != NULL) {
        if (strlen(a) > 1) {
            if (atual == sorteio) {
                a[strcspn(a, "\n")] = '\0';
                strcpy(escolhida, a);
                *tamanho = strlen(escolhida);
                break;
            }
            atual++;
        }
    }
    
    fclose(arquivo);
}

int Ganhar(int tamanho, char matriz[]){
    for(int i = 0; i < tamanho; i++) {
        if(matriz[i] == '_') {
            return 0;
        }
    }
    return 1;
}

void RevelarLetra(char letra, char *matriz, int pos) {
    matriz[pos] = letra;
}

int Validade(char letra) {
    char alfabeto[26];
    for(int i = 0; i < 26; i++) {
        alfabeto[i] = 'A' + i;
    } 

    for(int i = 0; i < 26; i++) {
        if (letra == alfabeto[i]) {
            return 0;
        }
    }
    return 1;
}

void Checagem(char letra, int *loop, char palavra[], int tamanho, char matriz[], char letras[]) {
    int flag=1;
    int pos;
    for(int i = 0; i < tamanho; i++) {
        if(letra == palavra[i]) {
            pos = i;
            RevelarLetra(letra, matriz, pos);
            flag = 0;
        }
    }
    if (flag) {
        letras[*loop] = letra;
        (*loop)++;
    }
}

void Maius(char palavra[], int tamanho, char escolhida[]) {
    for(int i = 0; i < tamanho; i++) {
        palavra[i] = toupper(escolhida[i]);
    }
    palavra[tamanho] = '\0';
}

void Tracinhos(int tamanho, char *matriz) {
    for (int i = 0; i < tamanho; i++) {
        matriz[i] = '_';
    }
}

void ImprimirLinha(char matriz[], int tamanho) {
    for(int i = 0; i < tamanho; i++) {
        printf("%c", matriz[i]);
        printf(" ");
    }
}

