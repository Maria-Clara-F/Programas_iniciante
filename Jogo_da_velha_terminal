#include <stdio.h>
#include <string.h>
#include <ctype.h>
#include <stdlib.h>
#include <time.h>
#include <unistd.h>

void preencher_tab(char tabuleiro[][3]) {
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            tabuleiro[i][j] = '-';
        }
    }
}

void mostrar_tab(char tabuleiro[][3]) {
    printf("    0      1      2\n");
    printf("  -----------------\n");
    for(int i = 0; i < 3; i++) {
        printf("%d |", i);
        for(int j = 0; j < 3; j++) {
            printf("[ %c ] ", tabuleiro[i][j]);
        }
        printf("\n");
    }
}

int ler_int(int *n, int min, int max) {
    if(scanf("%d", n)!=1) {
        while(getchar() != '\n');
        printf("Entrada invalida! Digite um numero: ");
        return 1;
    }

    if (*n < min || *n > max) {
        printf("Opcao invalida! Digite um numero valido: ");
        return 1;
    }
    return 0;
}

int verif_pos(int linha, int coluna, char tabuleiro[][3]) {
    if (tabuleiro[linha][coluna] == '-') {
        return 1;
    } else {
        printf("Espaco ja ocupado, digite outro!\n");
    }
    return 0;
}

void salvar_tabuleiro (int linha, int coluna, char tabuleiro[][3], int jogador) {
    if (jogador == 1) { 
        (tabuleiro[linha][coluna]) = 'X';
    }
    if (jogador == 2) {
        (tabuleiro[linha][coluna]) = 'O';
    }
}

int verificar_tabuleiro(char tabuleiro[][3], char *pos) {
    for (int i = 0; i < 3; i++) {
        if (tabuleiro[i][0] != '-' && tabuleiro[i][0] == tabuleiro[i][1] && tabuleiro[i][1] == tabuleiro[i][2]) {
            *pos = tabuleiro[i][0];
            return 1;
        }
    }

    for (int j = 0; j < 3; j++) {
        if (tabuleiro[0][j] != '-' && tabuleiro[0][j] == tabuleiro[1][j] && tabuleiro[1][j] == tabuleiro[2][j]) {
            *pos = tabuleiro[0][j];
            return 1;
        }
    }

    if (tabuleiro[0][0] != '-' && tabuleiro[0][0] == tabuleiro[1][1] && tabuleiro[1][1] == tabuleiro[2][2]) {
        *pos = tabuleiro[0][0]; return 1;
    }
    if (tabuleiro[0][2] != '-' && tabuleiro[0][2] == tabuleiro[1][1] && tabuleiro[1][1] == tabuleiro[2][0]) {
        *pos = tabuleiro[0][2]; return 1;
    }

    return 0;

}
void Jog_Jog() {
    int ok;
    int jogador = 1;
    char tabuleiro[3][3];
    preencher_tab(tabuleiro);
    mostrar_tab(tabuleiro);
    int ganhou = 0;
    char pos; 

    do {
        do {
            printf("Jogador %d [X] digite a linha:\n", jogador);
            int linha;
            while(ler_int(&linha, 0, 2));

            printf("Jogador %d [X] digite a coluna:\n", jogador);
            int coluna;
            while(ler_int(&coluna, 0, 2));

            ok = verif_pos(linha, coluna, tabuleiro);
            if (ok) {
                salvar_tabuleiro(linha, coluna, tabuleiro, jogador);
            }
        } while (!ok);
        mostrar_tab(tabuleiro);
        jogador++;
        if(jogador%2==0) {jogador = 2;}
        if(jogador%2!=0) {jogador = 1;}

        ganhou = verificar_tabuleiro(tabuleiro, &pos);
    } while (!ganhou);

    if (pos == 'X') { printf("Parabens Jogador 1! Voce venceu!\n");}
    if (pos == 'O') { printf("Parabens Jogador 2! Voce venceu!\n");}
}

void Comp_Jog() {
    int ok;
    char tabuleiro[3][3];
    preencher_tab(tabuleiro);
    mostrar_tab(tabuleiro);
    int ganhou = 0;
    char pos = ' '; 

    do {
        do {
            printf("[X] Digite a linha:\n");
            int linha;
            while(ler_int(&linha, 0, 2));

            printf("[X] Digite a coluna:\n");
            int coluna;
            while(ler_int(&coluna, 0, 2));

            ok = verif_pos(linha, coluna, tabuleiro);
            if (ok) {
                salvar_tabuleiro(linha, coluna, tabuleiro, 1);
            }
        } while (!ok);
        ganhou = verificar_tabuleiro(tabuleiro, &pos);

        if (ganhou==0) {
            do {
            printf("Computador jogando...\n");
            int linha = rand() % (3);
            int coluna = rand() % (3);
            ok = verif_pos(linha, coluna, tabuleiro); 
            if (ok) {
                salvar_tabuleiro(linha, coluna, tabuleiro, 2);
            }
            } while (!ok);
        }
        sleep(2);
        mostrar_tab(tabuleiro);

        ganhou = verificar_tabuleiro(tabuleiro, &pos);
    } while (!ganhou);

    if (pos == 'X') { printf("Parabens! Voce venceu!\n");}
    if (pos == 'O') { printf("GAME OVER! O computador venceu!\n");}
}

int main () {
    srand(time(NULL));
    int resposta;
    do {
        printf("========================\n");
        printf("      JOGO DA VELHA     \n");
        printf("========================\n");

        printf("Escolha o modo de jogo:\n");
        printf("[1] Computador x Jogador\n[2] Jogador x Jogador\n[3] Sair\n");
        while(ler_int(&resposta, 1, 3)); 
        if (resposta == 1) {Comp_Jog();}
        if (resposta == 2) {Jog_Jog();}
        if (resposta == 3) {return 0;}

    } while (resposta!=3);
    
    return 0;
}
