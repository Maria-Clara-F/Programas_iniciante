// funcao de ler int geral que adotei p vida
int ler_int(int *n, int min, int max) {
    if(scanf("%d", n)!=1) {
        while(getchar() != '\n');
        printf("Entrada invalida! Digite um numero: ");
        return 1;
    }

    if (*n < min || *n > max) {
        printf("Opcao invalida! Digite um numero valido: ");
        return 1;
    }
    return 0;
}

